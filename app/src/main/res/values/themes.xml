<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SaayaLite" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/saaya_icon_pin_highlight</item>
        <item name="android:navigationBarColor">@color/saaya_background</item>
        <item name="android:statusBarColor">@color/saaya_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/saaya_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SaayaLite.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/saaya_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SaayaLite</item>
    </style>
</resources>
