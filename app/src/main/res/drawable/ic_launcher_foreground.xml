<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- The viewport scales the master to 108 dp. Moving it 80 source units centres the
         pin: canvas centre 512 minus the source pin's vertical midpoint 432. -->
    <group android:translateY="80">
    <!-- Ambient violet field from saaya-icon-v2.svg. -->
    <path android:pathData="M842,372A330,330 0,1 1,182 372A330,330 0,1 1,842 372Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="372"
                android:gradientRadius="330">
                <item android:offset="0" android:color="#667C3AED" />
                <item android:offset="0.45" android:color="#385A41AA" />
                <item android:offset="1" android:color="#005A41AA" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Penumbra aura. VectorDrawable has no blur filter; the source silhouette remains. -->
    <path
        android:pathData="M344.2,482.9A208,208 0,1 1,679.8 482.9C609.3,579.1 542.2,670.8 512,712C481.8,670.8 414.7,579.1 344.2,482.9Z"
        android:fillColor="@color/saaya_icon_penumbra"
        android:fillAlpha="0.6" />

    <!-- Breadcrumb glow and solid dashes, mechanically copied from the master. -->
    <path
        android:pathData="M510.3,750.1L513.7,773.9"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/saaya_icon_pin_highlight"
        android:strokeAlpha="0.5"
        android:strokeWidth="34"
        android:strokeLineCap="round" />
    <path
        android:pathData="M520.2,815.7L527.8,836.3"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/saaya_icon_pin_body"
        android:strokeAlpha="0.5"
        android:strokeWidth="32"
        android:strokeLineCap="round" />
    <path
        android:pathData="M534.7,875.5L545.3,892.5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/saaya_icon_penumbra"
        android:strokeAlpha="0.5"
        android:strokeWidth="30"
        android:strokeLineCap="round" />
    <path
        android:pathData="M510.3,750.1L513.7,773.9"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/saaya_icon_pin_highlight"
        android:strokeAlpha="0.95"
        android:strokeWidth="34"
        android:strokeLineCap="round" />
    <path
        android:pathData="M520.2,815.7L527.8,836.3"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/saaya_icon_pin_body"
        android:strokeAlpha="0.8"
        android:strokeWidth="32"
        android:strokeLineCap="round" />
    <path
        android:pathData="M534.7,875.5L545.3,892.5"
        android:fillColor="@android:color/transparent"
        android:strokeColor="@color/saaya_icon_penumbra"
        android:strokeAlpha="0.62"
        android:strokeWidth="30"
        android:strokeLineCap="round" />

    <!-- The pin, with the source top-light gradient. -->
    <path android:pathData="M344.2,482.9A208,208 0,1 1,679.8 482.9C609.3,579.1 542.2,670.8 512,712C481.8,670.8 414.7,579.1 344.2,482.9Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="512"
                android:startY="152"
                android:endX="512"
                android:endY="712">
                <item android:offset="0" android:color="@color/saaya_icon_pin_highlight" />
                <item android:offset="1" android:color="@color/saaya_icon_pin_body" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Single soft top sheen, clipped to the source ellipse. -->
    <path android:pathData="M662,292A150,96 0,1 1,362 292A150,96 0,1 1,662 292Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="512"
                android:centerY="292"
                android:gradientRadius="150">
                <item android:offset="0" android:color="#38FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
    </group>
</vector>
